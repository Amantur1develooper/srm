# ── Django ─────────────────────────────────────────────
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=False
# через запятую: IP и/или домены, откуда открывают CRM
DJANGO_ALLOWED_HOSTS=162.35.171.106,127.0.0.1,localhost
# для доступа по HTTPS / через прокси (ngrok, cloudflared, домен):
DJANGO_CSRF_TRUSTED_ORIGINS=https://*.ngrok-free.app
DJANGO_USE_X_FORWARDED_HOST=True

# ── PostgreSQL ─────────────────────────────────────────
